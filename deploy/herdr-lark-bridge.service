[Unit]
Description=Herdr to Lark Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/herdr-lark-bridge
EnvironmentFile=/absolute/path/to/herdr-lark-bridge/.env
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/absolute/path/to/herdr-lark-bridge/var

[Install]
WantedBy=default.target
