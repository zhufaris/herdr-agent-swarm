{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/herdr-choice-stop-hook.mjs\" \"${PLUGIN_DATA}/activation.json\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/herdr-choice-stop-hook.mjs\" \"${PLUGIN_DATA}/activation.json\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
