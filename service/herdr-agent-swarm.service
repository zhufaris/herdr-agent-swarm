[Unit]
Description=Herdr Agent Swarm daemon (Herdr headless runtime and Feishu gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The installer renders absolute paths and the current build identity.
EnvironmentFile=%h/.config/herdr-agent-swarm/.env
Environment=PROJECTS_CONFIG_PATH=%h/.config/herdr-agent-swarm/projects.json
Environment=BRIDGE_DATABASE_PATH=%h/.local/state/herdr-agent-swarm/bridge.db
ExecStart=/usr/bin/env node /absolute/path/to/herdr-agent-swarm/dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=50

[Install]
WantedBy=default.target
