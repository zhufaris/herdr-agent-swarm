{
  "name": "herdr-lark-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/generate-build-info.mjs",
    "config:validate": "node dist/cli/validate-config.js",
    "plugin": "node dist/cli/plugin-lifecycle.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:real-user": "node scripts/real-user-smoke.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.56.0",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
