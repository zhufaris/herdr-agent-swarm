{
  "name": "herdr-agent-swarm",
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/sync-build-output.mjs prepare && tsc -p tsconfig.json && node scripts/sync-build-output.mjs publish && node scripts/generate-build-info.mjs",
    "release:package": "node scripts/package-release.mjs",
    "config:validate": "node dist/cli/validate-config.js",
    "docs:audit": "node scripts/audit-documentation.mjs",
    "public:audit": "node scripts/audit-public-release.mjs",
    "service": "node dist/cli/service-lifecycle.js",
    "primary-tools:mcp": "node dist/cli/primary-tools-mcp.js",
    "controller-tools:mcp": "node dist/cli/controller-tools-mcp.js",
    "swarm:init": "bash scripts/swarm-service.sh init",
    "swarm:setup": "node dist/cli/setup.js",
    "swarm:doctor": "node dist/cli/doctor.js",
    "swarm:install": "bash scripts/swarm-service.sh install",
    "swarm:start": "bash scripts/swarm-service.sh start",
    "swarm:status": "bash scripts/swarm-service.sh status",
    "swarm:restart": "bash scripts/swarm-service.sh restart",
    "swarm:stop": "bash scripts/swarm-service.sh stop",
    "swarm:logs": "bash scripts/swarm-service.sh logs",
    "dev": "tsx watch src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "architecture:check": "node scripts/check-architecture-imports.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "smoke:real-user": "node scripts/real-user-smoke.mjs",
    "smoke:headless-multi-agent": "tsx scripts/smoke-headless-multi-agent.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "pino": "^9.7.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
