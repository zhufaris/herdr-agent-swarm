{
  "name": "herdr-agent-swarm",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/generate-build-info.mjs",
    "config:validate": "node dist/cli/validate-config.js",
    "plugin": "node dist/cli/plugin-lifecycle.js",
    "primary-tools:mcp": "node dist/cli/primary-tools-mcp.js",
    "herdr:traex:install": "bash scripts/install-herdr-traex-shim.sh install",
    "herdr:traex:status": "bash scripts/install-herdr-traex-shim.sh status",
    "herdr:traex:uninstall": "bash scripts/install-herdr-traex-shim.sh uninstall",
    "swarm:init": "bash scripts/swarm-service.sh init",
    "swarm:migrate": "bash scripts/swarm-service.sh migrate",
    "swarm:install": "bash scripts/swarm-service.sh install",
    "swarm:start": "bash scripts/swarm-service.sh start",
    "swarm:status": "bash scripts/swarm-service.sh status",
    "swarm:restart": "bash scripts/swarm-service.sh restart",
    "swarm:stop": "bash scripts/swarm-service.sh stop",
    "swarm:logs": "bash scripts/swarm-service.sh logs",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:real-user": "node scripts/real-user-smoke.mjs",
    "smoke:headless-multi-agent": "tsx scripts/smoke-headless-multi-agent.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.56.0",
    "pino": "^9.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
