LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=replace-me
LARK_CHAT_ID=oc_xxxxxxxxxxxxxxxx
LARK_BOT_OPEN_ID=ou_xxxxxxxxxxxxxxxx
# Required: comma-separated Feishu users allowed to send prompts or use cards.
# The service refuses to start when this list is empty.
LARK_ALLOWED_OPEN_IDS=ou_replace_with_user_open_id
# Required administrative subset. Admins can create, start, stop, steer, and
# remove Workers, and can change a session's topology.
LARK_ADMIN_OPEN_IDS=ou_replace_with_admin_open_id
# Herdr Agent Swarm standalone default: ~/.config/herdr-agent-swarm/projects.json
# For foreground development, uncomment this repository-relative override:
# PROJECTS_CONFIG_PATH=./config/projects.json
# RUNTIME_CONFIG_PATH=./config/runtime.yaml
#
# Create config/projects.json from config/projects.example.json and fill in your
# Herdr workspace id and project cwd there.
#
# Herdr Agent Swarm standalone default: ~/.local/state/herdr-agent-swarm/bridge.db
# For foreground development, uncomment this repository-relative override:
# BRIDGE_DATABASE_PATH=./var/bridge.db
BRIDGE_HTTP_HOST=127.0.0.1
BRIDGE_HTTP_PORT=8787
# After installing the TraeX kind shim, use absolute paths here. HERDR_BIN is
# the shim symlink and TRAEX_BIN must match the real binary recorded by status.
HERDR_BIN=herdr
# Herdr Core events are authoritative by default. "jsonl" is an explicit
# operator rollback; "shadow" keeps JSONL authoritative while comparing Core.
# Core must allow these roots with HERDR_TRAEX_TRANSCRIPT_ROOT and
# HERDR_PI_TRANSCRIPT_ROOT (the latter is <SWARM_STATE_DIR>/pi-sessions).
HERDR_REPLY_OBSERVATION=events
TRAEX_BIN=traex
CODEX_BIN=codex
CLAUDE_CODE_BIN=claude
PI_BIN=pi
# Valid modes: default, auto, bypass_permissions.
# SECURITY: "bypass_permissions" lets allowed chat members run commands in
# Herdr without local approval. Keep "auto" for an isolated, least-privilege
# deployment; use bypass only with an explicitly accepted local risk.
TRAEX_PERMISSION_MODE=auto
LOG_LEVEL=info
CONTROLLER_ENABLED=true
CONTROLLER_TIMEOUT_MS=60000
# CONTROLLER_MODEL=
# Event hooks drive prompt card refresh; this 5s-1h full scan is the recovery fallback.
RECONCILE_INTERVAL_MS=300000
OUTBOX_SAFETY_SCAN_INTERVAL_MS=30000
# Core-event payload retention is independently gated; keep off until audit evidence is reviewed.
CORE_EVENT_RETENTION_MODE=off
CORE_EVENT_RETENTION_HOURS=24
# Controls non-Core retained Delivery, Timeline, and Conversation payloads only.
RETENTION_PAYLOAD_COMPACTION_ENABLED=false
HERDR_CIRCUIT_FAILURE_THRESHOLD=3
HERDR_CIRCUIT_OPEN_MS=15000
SQLITE_INTEGRITY_AUDIT_INTERVAL_MS=900000
