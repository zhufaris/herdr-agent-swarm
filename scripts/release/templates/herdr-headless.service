[Unit]
Description=Herdr headless server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=HERDR_CONFIG_PATH=@HERDR_CONFIG_PATH@
ExecStart=@HERDR_REAL_BIN@ server
StandardOutput=append:@HERDR_LOG_PATH@
StandardError=append:@HERDR_LOG_PATH@
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
