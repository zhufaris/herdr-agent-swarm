[Unit]
Description=Herdr Agent Swarm
Requires=herdr-headless.service
After=network-online.target herdr-headless.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@SWARM_RUNTIME_ROOT@
EnvironmentFile=@SWARM_ENV_PATH@
Environment=PROJECTS_CONFIG_PATH=@PROJECTS_CONFIG_PATH@
Environment=BRIDGE_DATABASE_PATH=@BRIDGE_DATABASE_PATH@
Environment=BRIDGE_EXPECTED_BUILD_ID=@SWARM_BUILD_ID@
ExecStart=@NODE_BIN@ --enable-source-maps @SWARM_RUNTIME_ROOT@/dist/main.js
StandardOutput=append:@SWARM_LOG_PATH@
StandardError=append:@SWARM_LOG_PATH@
Restart=on-failure
RestartSec=5
TimeoutStopSec=50

[Install]
WantedBy=default.target
