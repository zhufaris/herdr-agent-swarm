#!/bin/bash
set -euo pipefail

BUNDLE_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
# shellcheck source=lib/bundle-common.sh
source "$BUNDLE_ROOT/scripts/lib/bundle-common.sh"

SYSTEMCTL_BIN="${SWARM_BUNDLE_SYSTEMCTL:-systemctl}"
TRAEX_BIN="${SWARM_BUNDLE_TRAEX:-traex}"
ACTION="${1:-}"
CONFIG_DIR="${SWARM_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/herdr-agent-swarm}"
STATE_DIR="${SWARM_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/herdr-agent-swarm}"
UNIT_DIR="${SWARM_BUNDLE_SYSTEMD_UNIT_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user}"

usage() {
  printf 'usage: %s <verify|install|start|restart|status|logs|stop|uninstall> [options]\n' "$0" >&2
}

verify_release_metadata() {
  node - "$BUNDLE_ROOT/release.json" "$HERDR_RELEASE_VERSION" "$HERDR_RELEASE_SHA256" "$RELEASE_PLATFORM" <<'NODE'
const fs = require("node:fs");
const [path, herdrVersion, herdrSha256, platform] = process.argv.slice(2);
let release;
try { release = JSON.parse(fs.readFileSync(path, "utf8")); } catch (error) {
  process.stderr.write(`error: invalid release metadata: ${error.message}\n`); process.exit(1);
}
const valid = release.product === "herdr-agent-swarm"
  && typeof release.version === "string" && release.version.length > 0
  && /^[a-f0-9]{40}$/.test(release.gitCommit)
  && /^sha256:[a-f0-9]{64}$/.test(release.buildId)
  && release.platform === platform && release.node === ">=22.12"
  && release.herdrVersion === herdrVersion && release.herdrSha256 === herdrSha256
  && !Number.isNaN(Date.parse(release.createdAt));
if (!valid) { process.stderr.write("error: release metadata does not match the bundle contract\n"); process.exit(1); }
const [major, minor] = process.versions.node.split(".").map(Number);
if (major < 22 || (major === 22 && minor < 12)) {
  process.stderr.write(`error: Node.js 22.12+ required; found ${process.versions.node}\n`); process.exit(1);
}
NODE
}

verify_bundle() {
  bundle_require_linux_x64
  bundle_verify_manifest "$BUNDLE_ROOT"
  for path in \
    runtime/dist/main.js runtime/dist/cli/service-lifecycle.js runtime/package.json runtime/package-lock.json \
    templates/herdr-headless.service templates/herdr-agent-swarm.service templates/env.example templates/projects.example.json; do
    if [ ! -f "$BUNDLE_ROOT/$path" ]; then bundle_die "required bundle file is missing: $path"; return; fi
  done
  verify_release_metadata
  bundle_validate_herdr "$BUNDLE_ROOT/bin/herdr-real"
  if ! "$TRAEX_BIN" --version >/dev/null 2>&1; then bundle_die "TraeX is required but unavailable: $TRAEX_BIN"; return; fi
  if ! "$SYSTEMCTL_BIN" --user --version >/dev/null 2>&1; then bundle_die "user systemd is required but unavailable: $SYSTEMCTL_BIN"; return; fi
  printf 'Bundle verification passed: Herdr %s, %s, Node %s\n' "$HERDR_RELEASE_VERSION" "$RELEASE_PLATFORM" "$(node --version)"
}

release_field() {
  node -e 'const x=require(process.argv[1]); const value=x[process.argv[2]]; if (typeof value !== "string") process.exit(1); process.stdout.write(value)' \
    "$BUNDLE_ROOT/release.json" "$1"
}

systemd_path() {
  local value="$1"
  if [[ "$value" == *$'\n'* ]] || [[ "$value" == *$'\r'* ]]; then bundle_die "systemd path contains a line break"; return; fi
  value="${value//\\/\\x5c}"
  printf '%s' "${value// /\\x20}"
}

write_unit() {
  local template="$1" destination="$2" content
  shift 2
  content="$(cat "$template")"
  while [ "$#" -gt 0 ]; do
    content="${content//@$1@/$2}"
    shift 2
  done
  local temporary="$destination.tmp.$$"
  printf '%s\n' "$content" > "$temporary"
  chmod 600 "$temporary"
  mv -f "$temporary" "$destination"
}

install_bundle() {
  verify_bundle
  local version git_commit release_key releases release_path staging current_tmp
  version="$(release_field version)"
  git_commit="$(release_field gitCommit)"
  release_key="$version-${git_commit:0:12}"
  releases="$STATE_DIR/releases"
  release_path="$releases/$release_key"

  install -d -m 700 "$CONFIG_DIR" "$CONFIG_DIR/herdr" "$STATE_DIR" "$releases" "$STATE_DIR/logs" "$UNIT_DIR"
  if [ ! -d "$release_path" ]; then
    staging="$releases/.install-$release_key-$$"
    rm -rf -- "$staging"
    mkdir -m 700 "$staging"
    cp -a "$BUNDLE_ROOT/." "$staging/"
    mv "$staging" "$release_path"
  fi
  if [ ! -e "$CONFIG_DIR/.env" ]; then install -m 600 "$release_path/templates/env.example" "$CONFIG_DIR/.env"; fi
  if [ ! -e "$CONFIG_DIR/projects.json" ]; then install -m 600 "$release_path/templates/projects.example.json" "$CONFIG_DIR/projects.json"; fi
  touch "$STATE_DIR/logs/herdr.log" "$STATE_DIR/logs/service.log"
  chmod 600 "$STATE_DIR/logs/herdr.log" "$STATE_DIR/logs/service.log"

  current_tmp="$STATE_DIR/.current-$$"
  ln -s "$release_path" "$current_tmp"
  mv -Tf "$current_tmp" "$STATE_DIR/current"

  local escaped_release escaped_config escaped_state node_bin build_id
  escaped_release="$(systemd_path "$release_path")"
  escaped_config="$(systemd_path "$CONFIG_DIR")"
  escaped_state="$(systemd_path "$STATE_DIR")"
  node_bin="$(systemd_path "$(command -v node)")"
  build_id="$(release_field buildId)"
  write_unit "$release_path/templates/herdr-headless.service" "$UNIT_DIR/herdr-headless.service" \
    HERDR_CONFIG_PATH "$escaped_config/herdr/config.toml" HERDR_REAL_BIN "$escaped_release/bin/herdr-real" \
    HERDR_LOG_PATH "$escaped_state/logs/herdr.log"
  write_unit "$release_path/templates/herdr-agent-swarm.service" "$UNIT_DIR/herdr-agent-swarm.service" \
    SWARM_RUNTIME_ROOT "$escaped_release/runtime" SWARM_ENV_PATH "$escaped_config/.env" \
    PROJECTS_CONFIG_PATH "$escaped_config/projects.json" BRIDGE_DATABASE_PATH "$escaped_state/bridge.db" \
    SWARM_BUILD_ID "$build_id" NODE_BIN "$node_bin" SWARM_LOG_PATH "$escaped_state/logs/service.log"

  "$SYSTEMCTL_BIN" --user daemon-reload
  "$SYSTEMCTL_BIN" --user enable herdr-headless.service
  "$SYSTEMCTL_BIN" --user enable herdr-agent-swarm.service
  printf 'Installed release %s and enabled both user units; services were not started.\n' "$release_key"
}

installed_release() {
  local current="$STATE_DIR/current" resolved releases
  if [ ! -L "$current" ]; then bundle_die "bundle is not installed; run scripts/swarmctl install first"; return; fi
  resolved="$(readlink -f "$current")"
  releases="$(realpath -m "$STATE_DIR/releases")"
  case "$resolved" in "$releases"/*) ;; *) bundle_die "current release escapes the package release directory"; return ;; esac
  if [ ! -d "$resolved/runtime" ]; then bundle_die "installed release runtime is missing: $resolved"; return; fi
  printf '%s\n' "$resolved"
}

run_swarm_lifecycle() {
  local action="$1" release
  shift
  release="$(installed_release)"
  SWARM_ROOT="$release/runtime" SWARM_CONFIG_DIR="$CONFIG_DIR" SWARM_STATE_DIR="$STATE_DIR" \
    BRIDGE_SYSTEMD_UNIT_DIR="$UNIT_DIR" BRIDGE_REQUIRED_USER_UNIT="herdr-headless.service" \
    node "$release/runtime/dist/cli/service-lifecycle.js" "$action" "$@"
}

validate_configuration() {
  local release
  release="$(installed_release)"
  if grep -Eq 'replace-me|REPLACE_WITH_HERDR_WORKSPACE_ID|/absolute/path/to/your/project' \
    "$CONFIG_DIR/.env" "$CONFIG_DIR/projects.json"; then
    bundle_die "configuration still contains placeholders: $CONFIG_DIR/.env or $CONFIG_DIR/projects.json"
    return
  fi
  node "$release/runtime/dist/cli/validate-config.js" "$CONFIG_DIR/.env" "$CONFIG_DIR/projects.json"
}

wait_for_herdr() {
  local release attempt
  release="$(installed_release)"
  for attempt in $(seq 1 "${SWARM_BUNDLE_HERDR_READY_ATTEMPTS:-30}"); do
    if HERDR_CONFIG_PATH="$CONFIG_DIR/herdr/config.toml" "$release/bin/herdr-real" status server >/dev/null 2>&1 \
      && HERDR_CONFIG_PATH="$CONFIG_DIR/herdr/config.toml" "$release/bin/herdr-real" api snapshot >/dev/null 2>&1; then
      return 0
    fi
    sleep "${SWARM_BUNDLE_READY_INTERVAL_SECONDS:-1}"
  done
  bundle_die "Herdr headless did not become ready"
}

start_bundle() {
  validate_configuration
  "$SYSTEMCTL_BIN" --user start herdr-headless.service
  wait_for_herdr
  run_swarm_lifecycle start
}

restart_bundle() {
  if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--force" ]; }; then usage; return 2; fi
  run_swarm_lifecycle restart "$@"
}

status_bundle() {
  local result=0
  "$SYSTEMCTL_BIN" --user status --no-pager herdr-headless.service || result=$?
  if ! wait_for_herdr; then result=1; fi
  run_swarm_lifecycle status || result=$?
  return "$result"
}

logs_bundle() {
  local target="${1:-swarm}" path
  if [ "$#" -gt 1 ] || { [ "$target" != "herdr" ] && [ "$target" != "swarm" ]; }; then usage; return 2; fi
  path="$STATE_DIR/logs/service.log"
  if [ "$target" = "herdr" ]; then path="$STATE_DIR/logs/herdr.log"; fi
  if [ ! -f "$path" ]; then bundle_die "log file does not exist: $path"; return; fi
  tail -c 1048576 "$path" | tail -n 100
}

stop_bundle() {
  run_swarm_lifecycle stop
  "$SYSTEMCTL_BIN" --user stop herdr-headless.service
}

uninstall_bundle() {
  local purge=0 releases canonical_state canonical_home
  if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ "$1" != "--purge-releases" ]; }; then usage; return 2; fi
  if [ "${1:-}" = "--purge-releases" ]; then purge=1; fi
  if "$SYSTEMCTL_BIN" --user is-active --quiet herdr-agent-swarm.service \
    || "$SYSTEMCTL_BIN" --user is-active --quiet herdr-headless.service; then
    bundle_die "stop both services before uninstalling"
    return
  fi
  "$SYSTEMCTL_BIN" --user disable herdr-agent-swarm.service herdr-headless.service || true
  rm -f -- "$UNIT_DIR/herdr-agent-swarm.service" "$UNIT_DIR/herdr-headless.service"
  "$SYSTEMCTL_BIN" --user daemon-reload
  if [ "$purge" -eq 1 ]; then
    canonical_state="$(realpath -m "$STATE_DIR")"
    canonical_home="$(realpath -m "$HOME")"
    releases="$(realpath -m "$STATE_DIR/releases")"
    if [ "$canonical_state" = "/" ] || [ "$canonical_state" = "$canonical_home" ] \
      || [ "$releases" = "/" ] || [ "$releases" = "$canonical_home" ] || [ "$releases" = "$canonical_state" ] \
      || [ "$releases" != "$canonical_state/releases" ]; then
      bundle_die "refusing unsafe release purge path: $releases"
      return
    fi
    rm -f -- "$STATE_DIR/current"
    if [ -L "$STATE_DIR/releases" ]; then bundle_die "refusing to purge a symlinked releases directory"; return; fi
    if [ -d "$releases" ]; then rm -rf -- "$releases"; fi
  fi
  printf 'Removed package-owned user units; configuration and runtime state were preserved.\n'
}

case "$ACTION" in
  verify) [ "$#" -eq 1 ] || { usage; exit 2; }; verify_bundle ;;
  install) [ "$#" -eq 1 ] || { usage; exit 2; }; install_bundle ;;
  start) [ "$#" -eq 1 ] || { usage; exit 2; }; start_bundle ;;
  restart) shift; restart_bundle "$@" ;;
  status) [ "$#" -eq 1 ] || { usage; exit 2; }; status_bundle ;;
  logs) shift; logs_bundle "$@" ;;
  stop) [ "$#" -eq 1 ] || { usage; exit 2; }; stop_bundle ;;
  uninstall) shift; uninstall_bundle "$@" ;;
  "") usage; exit 2 ;;
  *) printf 'error: command is not implemented yet: %s\n' "$ACTION" >&2; usage; exit 2 ;;
esac
